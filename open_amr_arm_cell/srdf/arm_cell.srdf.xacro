<?xml version="1.0"?>
<!-- Semantic description of the palletizing cell: UR's own SRDF macro (group ur_manipulator, self-collision pairs)
     plus the cell's planning group `arm` (base_link -> tcp, the vacuum cup face) and the gripper/pedestal pairs. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="arm_cell">
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf/>

  <group name="arm">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>
  <!-- home: upright over the pedestal, tool pointing down -->
  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>

  <disable_collisions link1="pedestal" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="pedestal" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="vacuum_gripper" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="vacuum_gripper" link2="tool0" reason="Adjacent"/>
</robot>
