<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="open_amr">

    <xacro:property name="M_PI" value="3.1415926535897931" />

     <!-- Define caster wheel parameters -->
    <xacro:property name="caster_x" value="0.275" />
    <xacro:property name="caster_y" value="0.215" />
    <!-- 2 mm caster clearance: with all 6 contacts exactly on the ground the base rests on the rigid
         casters and the drive wheels get ~zero normal force (no traction). Lifting the casters
         puts the weight on the wheels; the robot rocks <0.5 deg onto one caster pair. -->
    <xacro:property name="caster_z" value="-0.048" />
    <xacro:property name="caster_radius" value="0.05" />

    <xacro:arg name="robot_name" default="open_amr"/>
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="isaac_ns" default=""/>
    <!-- lidar: nanoscan3 = two SICK nanoScan3 safety scanners at diagonal corners (MiR250 layout; the robot's design since
         2026-10-03: safety-rated, 360 deg); rplidar = the original single RPLIDAR A1M8 (Gazebo stack) -->
    <xacro:arg name="lidar" default="nanoscan3"/>   <!-- Isaac Sim with ros2_control (sim real-inputs mode): the namespace of the robot -->
    <!-- Rendered by robot_state_publisher.launch.py per robot instance; default = checked-in un-prefixed config -->
    <xacro:arg name="controllers_file" default="$(find open_amr_description)/config/open_amr/ros2_controllers.yaml"/>
    <!-- Kinematic body-twist plugin. OFF by default: it double-actuates the robot together with ros2_control -->
    <xacro:arg name="use_velocity_control_plugin" default="false"/>



    <xacro:include filename="$(find open_amr_description)/urdf/mech/open_amr_base.urdf.xacro"/>
    <xacro:include filename="$(find open_amr_description)/urdf/mech/diff_wheel.urdf.xacro"/>
    <xacro:include filename="$(find open_amr_description)/urdf/sensors/rgbd_camera.urdf.xacro"/>
    <xacro:include filename="$(find open_amr_description)/urdf/sensors/lidar.urdf.xacro"/>
    <xacro:include filename="$(find open_amr_description)/urdf/sensors/nanoscan3.urdf.xacro"/>
    <xacro:include filename="$(find open_amr_description)/urdf/sensors/imu.urdf.xacro"/>
    <xacro:include filename="$(find open_amr_description)/urdf/mech/caster_wheel.urdf.xacro"/>

    <xacro:open_amr_base prefix="$(arg prefix)"/>

    <xacro:diff_wheel
      prefix="$(arg prefix)"
      side="right"
      y_reflect="-1"/>

    <xacro:diff_wheel
      prefix="$(arg prefix)"
      side="left"
      y_reflect="1"/>

    <!-- Add 4 caster wheels -->
    <xacro:caster_wheel prefix="$(arg prefix)" parent="base_link" name="front_left"
        xyz="${caster_x} ${caster_y} ${caster_z}" rpy="0 0 0" radius="${caster_radius}"/>
    <xacro:caster_wheel prefix="$(arg prefix)" parent="base_link" name="front_right"
        xyz="${caster_x} ${-caster_y} ${caster_z}" rpy="0 0 0" radius="${caster_radius}"/>
    <xacro:caster_wheel prefix="$(arg prefix)" parent="base_link" name="rear_left"
        xyz="${-caster_x} ${caster_y} ${caster_z}" rpy="0 0 0" radius="${caster_radius}"/>
    <xacro:caster_wheel prefix="$(arg prefix)" parent="base_link" name="rear_right"
        xyz="${-caster_x} ${-caster_y} ${caster_z}" rpy="0 0 0" radius="${caster_radius}"/>

    <xacro:rgbd_camera
      prefix="$(arg prefix)"
      camera_name="cam_1"
      xyz_offset="0.39 0.02 0.042"
      rpy_offset="0 0 0"/>

    <xacro:if value="${'$(arg lidar)' == 'rplidar'}">
    <xacro:lidar_sensor
        prefix="$(arg prefix)"
        parent="base_link"
        frame_id="laser_frame"
        xyz_offset="0.320 0 0.12"
        rpy_offset="0 0 0"
        mesh_xyz_offset="-0.3 0 -0.22"
        mesh_rpy_offset="${M_PI/2} 0 0"
        topic_name="scan"/>
    </xacro:if>
    <xacro:if value="${'$(arg lidar)' == 'nanoscan3'}">
      <!-- optical centres on the collision outline's corners (x -0.39..0.416, y +-0.319), scan plane 0.12 m above
           base_link (0.22 m above the floor, as the old lidar), aimed diagonally outward -->
      <xacro:nanoscan3 prefix="$(arg prefix)" name="front_laser_link" xyz="0.416 0.319 0.12" rpy="0 0 ${M_PI/4}"
                       topic="scan_front"/>
      <xacro:nanoscan3 prefix="$(arg prefix)" name="rear_laser_link" xyz="-0.39 -0.319 0.12" rpy="0 0 ${-3*M_PI/4}"
                       topic="scan_rear"/>
      <!-- the merged 360 deg scan (dual_laser_merger) for AMCL: a virtual scanner at the base centre, scan height -->
      <link name="$(arg prefix)scan_merged_link"/>
      <joint name="$(arg prefix)scan_merged_joint" type="fixed">
        <parent link="$(arg prefix)base_link"/>
        <child link="$(arg prefix)scan_merged_link"/>
        <origin xyz="0 0 0.12" rpy="0 0 0"/>
      </joint>
    </xacro:if>

    <xacro:imu_sensor
      prefix="$(arg prefix)"
      parent="base_link"
      frame_id="imu"
      xyz_offset="0 0 0.006"
      rpy_offset="0 0 0"
      update_rate="50.0"
      topic_name="imu/data"/>

    <xacro:include filename="$(find open_amr_description)/urdf/control/velocity_control_plugin.urdf.xacro" />
    <xacro:if value="$(arg use_velocity_control_plugin)">
      <xacro:load_velocity_control_plugin use_gazebo="$(arg use_gazebo)"/>
    </xacro:if>

    <xacro:include filename="$(find open_amr_description)/urdf/control/gazebo_sim_ros2_control.urdf.xacro" />
    <xacro:load_gazebo_sim_ros2_control_plugin
      robot_name="$(arg robot_name)"
      controllers_file="$(arg controllers_file)"
      use_gazebo="$(arg use_gazebo)"/>

    <xacro:include filename="$(find open_amr_description)/urdf/control/open_amr_ros2_control.urdf.xacro" />
    <xacro:open_amr_ros2_control
      prefix="$(arg prefix)"
      use_gazebo="$(arg use_gazebo)"
      isaac_ns="$(arg isaac_ns)"/>


</robot>
